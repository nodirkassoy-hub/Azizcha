# Telegram bot integration (SERVER ONLY — never expose to the browser).
# Create a bot with @BotFather, get the token, add the bot to your chat/channel.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token
# Numeric chat id (e.g. -1001234567890) or @channelusername
TELEGRAM_CHAT_ID=@your_channel_or_numeric_chat_id
